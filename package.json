{
  "name": "dsh-live-status-hud",
  "version": "1.0.1",
  "description": "Playful live activity & Chinese chain-of-thought bubble plugin for DeepSeek Harness (dsh 0.2.2+), with zero-overlap mascot adaptation and a built-in mini whale companion.",
  "license": "MIT",
  "type": "module",
  "icon": "./assets/icon.svg",
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "node": ">=22.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "live-status",
    "chain-of-thought",
    "overlay",
    "dsh-whale-widget",
    "dsh-pet"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.cjs",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "assets",
    "locale",
    "docs",
    "demo",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/cordis": "*",
    "react": ">=18.0.0"
  }
}